{
  "manifest_version": 3,
  "name": "Resume Application Copilot",
  "version": "0.3.7",
  "description": "Build a local encrypted candidate profile, review form mappings, and safely prefill recruitment forms.",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel", "tabs"],
  "optional_host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Resume Application Copilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html"
}
